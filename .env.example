# Peak Hour LIVE trail-monitor defaults.
# The scheduled launcher (candidates/start_tsd_trail_monitor_scheduled.ps1)
# pins these so a stale User env cannot restore hard sells.
# Secrets (POLYGON_API_KEY, SUPABASE_*, TELEGRAM_*) stay in the untracked .env.
# Broker STP protective sells are not gated by these flags.

# Hard structure_stop / be_lock_1r software dumps. Default OFF (all-trailing).
# Either=1 restores Phase 2.5 dumps. See candidates/tsd_scan_pipeline/REVERT.md.
TSD_LIVE_STRUCTURE_STOP=0
PHP_STRUCTURE_STOP_EXITS=0

# Live T1 hard bank at +2% (reason=t1_bank). Default OFF — T1 trails.
# Paper/shadow 3R and research keep-profit sims are not this flag.
# Either=1 restores the live hard slice.
TSD_LIVE_T1_HARD_BANK=0
PHP_LIVE_T1_HARD_BANK=0

# Software kill / trail stop-hit price (code, not an env switch):
# LIVE checks use last/close, or interval_low/bar_low for the current
# interval only. IB ticker.low (session day low) is stored as session_low
# and must never by itself trigger a software kill.
